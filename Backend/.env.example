PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Usá sandbox para probar; requiere un Access Token TEST- de una cuenta de prueba.
MP_ENVIRONMENT=sandbox
MP_ACCESS_TOKEN=
# Opcional en desarrollo local; necesario para notificaciones en un backend público.
# BACKEND_PUBLIC_URL=https://api.tudominio.com
DATABASE_URL=postgresql://postgres:tu_contrasena@localhost:5432/sabor_vivo
JWT_SECRET=reemplazar-por-una-clave-aleatoria-larga
# Cuentas admin 1128720465 y 1133113604. Define ambas contraseñas (8-72 caracteres).
# Se actualizan desde estas variables al iniciar el backend. No las compartas.
ADMIN_PASSWORD_1=
ADMIN_PASSWORD_2=
# Activar solo si PostgreSQL exige SSL:
# PGSSL=true